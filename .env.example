# OmniMind AI OS Configuration Template

# Database configuration
DATABASE_URL=sqlite:///./omnimind.db

# Vector Store directory
CHROMA_DB_DIR=./chroma_db

# Simulation Mode (Set to True for mock responses without real provider calls)
SIMULATION_MODE=True

# Allow Simulation Fallback (If False, failed real provider calls return an honest error;
# if True, discloses fallback in response metadata: is_simulated=True, is_fallback=True)
ALLOW_SIMULATION_FALLBACK=False

# Local Ollama Configuration (Default local provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=60.0

# Remote API Keys (Optional; required only if routing to remote providers)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Default Provider & Model Selection (Optional: override complexity-based routing)
# Examples:
#   DEFAULT_LLM_PROVIDER=ollama
#   DEFAULT_LLM_MODEL=phi:latest
#   DEFAULT_LLM_PROVIDER=openai
#   DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=

# Redis Cache URL (Optional)
REDIS_URL=

# Streamlit Frontend Backend Connection
API_BASE_URL=http://127.0.0.1:8000/api/v1

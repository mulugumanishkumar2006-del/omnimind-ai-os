# OmniMind AI OS Configuration Template

# Database configuration
DATABASE_URL=sqlite:///./omnimind.db

# Vector Store directory
CHROMA_DB_DIR=./chroma_db

# Simulation Mode (Set to True for mock responses without API keys)
SIMULATION_MODE=True

# API Keys (Optional in Simulation Mode; set to enable real provider calls)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Redis Cache URL (Optional)
REDIS_URL=

# Streamlit Frontend Backend Connection
API_BASE_URL=http://127.0.0.1:8000/api/v1
